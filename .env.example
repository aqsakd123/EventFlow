# Copy this file to .env for local Compose/Kubernetes runs. Never commit .env.
POSTGRES_USER=eventflow
POSTGRES_PASSWORD=replace-me-postgres
REPLICATION_USER=eventflow_replica
REPLICATION_PASSWORD=replace-me-replication
RABBITMQ_USERNAME=eventflow
RABBITMQ_PASSWORD=replace-me-rabbitmq
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
KEYCLOAK_ADMIN_USERNAME=admin
KEYCLOAK_ADMIN_PASSWORD=replace-me-keycloak-admin
KEYCLOAK_ORGANIZER_PASSWORD=replace-me-organizer
KEYCLOAK_PARTICIPANT_PASSWORD=replace-me-participant
KEYCLOAK_CHECKIN_PASSWORD=replace-me-checkin
EVENT_RECONCILIATION_INTERNAL_KEY=replace-me-reconciliation
CORS_ALLOWED_ORIGINS=http://localhost:4173,http://localhost:4174
